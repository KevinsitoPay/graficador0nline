---
import App from '../components/App';
import TestReport from '../components/TestReport';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Graficador - Taekwondo</title>
  </head>
  <body>
    <main>
      <div class="container">
        <header>
          <h1>Graficador de Taekwondo</h1>
          <p class="subtitle">Sistema de emparejamiento automático</p>
        </header>
        
        <App client:load />
        <TestReport client:load />
      </div>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #f5f5f5;
    margin: 0;
    padding: 20px;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  header {
    text-align: center;
    margin-bottom: 30px;
  }
  
  h1 {
    color: #1a1a2e;
    margin: 0;
  }
  
  .subtitle {
    color: #666;
    margin-top: 5px;
  }
</style>